MONGODB_URI=your-mongodb-atlas-connection-string
JWT_SECRET=your_jwt_secret_key

# Optional: set if MongoDB SRV lookups fail on your network
# DNS_SERVERS=1.1.1.1,8.8.8.8

PORT=4000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# true = Secure cookies. Defaults to true only when NODE_ENV=production.
COOKIE_SECURE=false

# Optional (GEN-08): where uploaded images are stored. Defaults to backend/uploads
# UPLOAD_DIR=

# Used by `npm run seed:admin` (ACC-18)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
